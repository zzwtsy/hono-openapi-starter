{
  "name": "backend",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/backend/clean-dist.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node ../../scripts/backend/copy-runtime-assets.mjs && node ../../scripts/backend/verify-dist.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "migrate": "node --enable-source-maps dist/commands/migrate.js",
    "bootstrap": "node --enable-source-maps dist/commands/bootstrap-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:contract": "vitest run --project contract",
    "openapi:export": "tsx src/app/export-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/commands/migrate.ts",
    "db:seed": "tsx src/commands/seed-development.ts",
    "db:bootstrap": "tsx src/commands/bootstrap-admin.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate:reference": "mkdir -p ../../.cache/better-auth && auth generate --config better-auth.config.ts --output ../../.cache/better-auth/auth-schema.ts --yes"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@loglayer/hono": "catalog:",
    "@loglayer/plugin-redaction": "catalog:",
    "@loglayer/transport-log-file-rotation": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-rate-limiter": "catalog:",
    "loglayer": "catalog:",
    "postgres": "catalog:",
    "serialize-error": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loglayer/transport-simple-pretty-terminal": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
