{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "inlineSourceMap": false,
    "inlineSources": false,
    "noEmitOnError": true,
    "outDir": "./dist",
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "scripts/**/*.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "better-auth.config.ts"
  ]
}
